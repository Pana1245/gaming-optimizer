{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GamingOptimizer-Installer",
  "version": "2.2.1",
  "identifier": "com.danidev.gamingoptimizer.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instalar Gaming Optimizer",
        "width": 760,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
